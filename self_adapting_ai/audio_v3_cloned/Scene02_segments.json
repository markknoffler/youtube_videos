   "voiced": 146,
   "sim": 0.705,
   "f0": 120.781,
   "st": 0.112,
   "range_st": 4.574,
   "asr": 1.0,
   "attempts": 1,
   "level": 0
  },
  {
   "i": 18,
   "s": 95.255,
   "e": 98.235,
   "text": "physically alters the wiring of your cerebral cortex.",
   "dur": 2.98,
   "voiced": 189,
   "sim": 0.797,
   "f0": 114.148,
   "st": -0.866,
   "range_st": 9.506,
   "asr": 1.0,
   "attempts": 2,
   "level": 0
  },
  {
   "i": 19,
   "s": 99.286,
   "e": 102.585,
   "text": "Biological computation is event-driven and asynchronous.",
   "dur": 3.299,
   "voiced": 260,
   "sim": 0.774,
   "f0": 121.129,
   "st": 0.162,
   "range_st": 5.241,
   "asr": 0.857,
   "attempts": 1,
   "level": 0
  },
  {
   "i": 20,
   "s": 103.108,
   "e": 109.628,
   "text": "Neurons communicate via sparse millisecond electrical action potentials at frequencies of only one to ten hertz,",
   "dur": 6.52,
   "voiced": 505,
   "sim": 0.87,
   "f0": 119.319,
   "st": -0.099,
   "range_st": 5.347,
   "asr": 0.903,
   "attempts": 1,
   "level": 0
  },
  {
   "i": 21,
   "s": 109.882,
   "e": 112.763,
   "text": "avoiding wasteful continuous synchronization clocks.",
   "dur": 2.881,
   "voiced": 194,
   "sim": 0.831,
   "f0": 118.919,
   "st": -0.157,
   "range_st": 4.959,
   "asr": 0.8,
   "attempts": 1,
   "level": 0
  },
  {
   "i": 22,
   "s": 113.752,
   "e": 120.18,
   "text": "Now compare this living, breathing architecture to a modern artificial intelligence data center.",
   "dur": 6.428,
   "voiced": 480,
   "sim": 0.786,
   "f0": 113.406,
   "st": -0.978,
   "range_st": 2.592,
   "asr": 0.923,
   "attempts": 1,
   "level": 0
  },
  {
   "i": 23,
   "s": 120.88,
   "e": 128.672,
   "text": "A frontier GPU cluster consumes megawatts of electrical power, requiring massive liquid cooling towers and industrial substations.",
   "dur": 7.791,
   "voiced": 571,
   "sim": 0.842,
   "f0": 117.744,
   "st": -0.329,
   "range_st": 10.983,
   "asr": 1.0,
   "attempts": 1,
   "level": 0
  },
  {
   "i": 24,
   "s": 129.155,
   "e": 135.441,
   "text": "Inside, millions of identical matrix operations are broadcast across rigid, invariant systolic arrays.",
   "dur": 6.286,
