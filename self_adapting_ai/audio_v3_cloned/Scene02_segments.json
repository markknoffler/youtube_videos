   "f0": 111.405,
   "st": -1.287,
   "range_st": 6.221,
   "asr": 0.889,
   "attempts": 1,
   "level": 0
  },
  {
   "i": 25,
   "s": 136.215,
   "e": 140.988,
   "text": "Why couldn't our artificial neural networks work like living biology?",
