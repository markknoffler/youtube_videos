   "f0": 122.786,
   "st": 0.397,
   "range_st": 9.551,
   "asr": 0.875,
   "attempts": 2,
   "level": 0
  },
  {
   "i": 14,
   "s": 72.775,
   "e": 77.455,
   "text": "Instead of incurring massive memory bottlenecks with raw key-value caches,",
