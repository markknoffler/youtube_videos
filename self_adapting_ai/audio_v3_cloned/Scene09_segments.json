   "sim": 0.802,
   "f0": 112.182,
   "st": -1.166,
   "range_st": 3.094,
   "asr": 0.929,
   "attempts": 2,
   "level": 0
  },
  {
   "i": 6,
   "s": 34.504,
   "e": 37.537,
   "text": "They achieved this through two revolutionary innovations.",
   "dur": 3.032,
   "voiced": 199,
   "sim": 0.678,
   "f0": 120.026,
   "st": 0.004,
   "range_st": 7.516,
   "asr": 1.0,
   "attempts": 2,
   "level": 0
  },
  {
   "i": 7,
   "s": 38.752,
   "e": 41.558,
   "text": "First, through fine-grained Mixture of Experts.",
   "dur": 2.806,
   "voiced": 144,
   "sim": 0.827,
   "f0": 127.387,
   "st": 1.034,
   "range_st": 11.309,
   "asr": 0.857,
   "attempts": 5,
   "level": 2,
   "weak": true
  },
  {
   "i": 8,
   "s": 42.808,
   "e": 47.916,
   "text": "DeepSeek-V3 deploys two hundred and fifty-six routed experts in each layer.",
   "dur": 5.108,
   "voiced": 377,
   "sim": 0.786,
   "f0": 123.564,
   "st": 0.507,
   "range_st": 7.993,
   "asr": 0.8,
   "attempts": 2,
   "level": 0
  },
  {
   "i": 9,
   "s": 48.235,
   "e": 52.342,
   "text": "For any given token, a routing gate dynamically activates only eight of them,",
   "dur": 4.108,
   "voiced": 302,
   "sim": 0.806,
   "f0": 122.76,
   "st": 0.394,
   "range_st": 7.168,
   "asr": 1.0,
   "attempts": 1,
   "level": 0
  },
  {
   "i": 10,
   "s": 52.583,
   "e": 55.65,
   "text": "alongside one shared expert that every token uses.",
   "dur": 3.067,
   "voiced": 206,
   "sim": 0.766,
   "f0": 112.976,
   "st": -1.044,
   "range_st": 3.165,
   "asr": 0.875,
   "attempts": 1,
   "level": 0
  },
  {
   "i": 11,
   "s": 56.917,
   "e": 60.997,
   "text": "This achieves extreme conditional specialization and sparse execution,",
   "dur": 4.08,
   "voiced": 255,
   "sim": 0.843,
   "f0": 118.456,
   "st": -0.224,
   "range_st": 6.219,
   "asr": 1.0,
   "attempts": 1,
   "level": 0
  },
  {
   "i": 12,
   "s": 61.369,
   "e": 67.769,
   "text": "while keeping every expert a dense, hardware-friendly matrix, connected through collective all-to-all communication primitives.",
   "dur": 6.4,
   "voiced": 427,
   "sim": 0.832,
   "f0": 115.933,
   "st": -0.597,
   "range_st": 4.156,
   "asr": 0.941,
   "attempts": 1,
   "level": 0
  },
  {
   "i": 13,
   "s": 68.744,
   "e": 72.46,
   "text": "Second, through Multi-head Latent Attention, or MLA.",
