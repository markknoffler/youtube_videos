   "voiced": 510,
   "sim": 0.836,
   "f0": 120.213,
   "st": 0.031,
   "range_st": 7.278,
   "asr": 0.941,
   "attempts": 2,
   "level": 0
  },
  {
   "i": 19,
   "s": 99.118,
