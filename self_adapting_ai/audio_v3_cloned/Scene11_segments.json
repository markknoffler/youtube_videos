   "range_st": 3.661,
   "asr": 0.811,
   "attempts": 3,
   "level": 1
  },
  {
   "i": 11,
   "s": 43.739,
   "e": 46.729,
   "text": "The network still rewires its own topology,",
   "sim": 0.0,
   "dur": 2.99,
