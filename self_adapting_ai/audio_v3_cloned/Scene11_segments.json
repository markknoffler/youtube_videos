   "attempts": 6,
   "level": 3,
   "weak": true
  },
  {
   "i": 7,
   "s": 23.863,
   "e": 27.08,
   "text": "But a tensor core does not see synapses.",
   "sim": 0.0,
   "dur": 3.217,
   "asr": 0.0,
   "trusted": true,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 8,
   "s": 27.7,
   "e": 29.721,
   "text": "It sees small dense tiles.",
   "sim": 0.0,
   "dur": 2.021,
   "asr": 0.0,
   "trusted": true,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 9,
   "s": 30.971,
   "e": 35.815,
