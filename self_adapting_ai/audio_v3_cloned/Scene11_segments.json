   "attempts": 1,
   "level": 0
  },
  {
   "i": 5,
   "s": 16.789,
   "e": 19.143,
   "text": "rewire tiles, not synapses.",
   "sim": 0.0,
   "dur": 2.354,
   "asr": 0.0,
   "trusted": true,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 6,
   "s": 19.726,
   "e": 23.56,
   "text": "Theorem three told us that random sparse graphs starve the GPU.",
