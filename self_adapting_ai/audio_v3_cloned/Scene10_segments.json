   "asr": 0.0,
   "trusted": true,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 13,
   "s": 43.161,
   "e": 48.791,
   "text": "In 2021, Imanol Schlag, Kazuki Irie and J\u00fcrgen Schmidhuber proved it formally.",
   "sim": 0.0,
   "dur": 5.631,
   "asr": 0.0,
   "trusted": true,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 14,
   "s": 49.011,
   "e": 52.451,
