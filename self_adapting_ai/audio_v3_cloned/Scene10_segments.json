   "range_st": 1.853,
   "asr": 1.0,
   "attempts": 2,
   "level": 0
  },
  {
   "i": 24,
   "s": 90.271,
   "e": 94.563,
   "text": "Schlag's team showed that pure outer-product writing hits a hard capacity wall.",
