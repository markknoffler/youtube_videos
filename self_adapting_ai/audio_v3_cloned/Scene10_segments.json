   "trusted": true,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 16,
   "s": 61.78,
   "e": 65.296,
   "text": "The idea is older than the Transformer itself.",
   "sim": 0.0,
   "dur": 3.516,
