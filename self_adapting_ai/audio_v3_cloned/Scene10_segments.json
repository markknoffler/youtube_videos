   "f0": 118.391,
   "st": -0.234,
   "range_st": 5.317,
   "asr": 0.833,
   "attempts": 1,
   "level": 0
  },
  {
   "i": 21,
   "s": 83.794,
   "e": 86.187,
   "text": "It moved Hebb out of the synapse...",
