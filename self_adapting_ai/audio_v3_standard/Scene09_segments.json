   "f0": 125.312,
   "st": -0.367,
   "range_st": 7.557,
   "asr": 1.0,
   "attempts": 1,
   "level": 0
  },
  {
   "i": 14,
   "s": 91.295,
   "e": 97.038,
   "text": "Instead of incurring massive memory bottlenecks with raw key-value caches,",
   "dur": 5.743,
