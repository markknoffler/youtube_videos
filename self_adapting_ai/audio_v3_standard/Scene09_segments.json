   "f0": 124.855,
   "st": -0.431,
   "range_st": 8.486,
   "asr": 1.0,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 4,
   "s": 29.533,
   "e": 30.476,
   "text": "Instead,",
   "dur": 0.943,
   "voiced": 50,
   "sim": 0.639,
   "f0": 135.669,
   "st": 1.007,
   "range_st": 10.251,
   "asr": 1.0,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 5,
   "s": 30.851,
   "e": 39.68,
   "text": "they engineered structural adaptability directly within the rigid mathematical geometry of dense tensor matrices.",
   "dur": 8.829,
   "voiced": 547,
   "sim": 0.845,
   "f0": 131.317,
   "st": 0.443,
   "range_st": 9.15,
   "asr": 1.0,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 6,
   "s": 41.016,
   "e": 45.487,
   "text": "They achieved this through two revolutionary innovations.",
   "dur": 4.471,
   "voiced": 240,
   "sim": 0.831,
   "f0": 134.165,
   "st": 0.814,
   "range_st": 9.855,
   "asr": 1.0,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 7,
   "s": 46.702,
   "e": 50.415,
   "text": "First, through fine-grained Mixture of Experts.",
   "dur": 3.713,
   "voiced": 168,
   "sim": 0.756,
   "f0": 125.088,
   "st": -0.398,
   "range_st": 8.481,
   "asr": 1.0,
   "attempts": 1,
   "level": 0
  },
  {
   "i": 8,
   "s": 51.665,
   "e": 58.488,
   "text": "DeepSeek-V3 deploys two hundred and fifty-six routed experts in each layer.",
   "dur": 6.823,
   "voiced": 338,
   "sim": 0.825,
   "f0": 123.037,
   "st": -0.685,
   "range_st": 8.606,
   "asr": 0.96,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 9,
   "s": 58.807,
   "e": 64.642,
   "text": "For any given token, a routing gate dynamically activates only eight of them,",
   "dur": 5.835,
   "voiced": 362,
   "sim": 0.898,
   "f0": 130.389,
   "st": 0.32,
   "range_st": 9.078,
   "asr": 1.0,
   "attempts": 1,
   "level": 0
  },
  {
   "i": 10,
   "s": 64.883,
   "e": 69.319,
   "text": "alongside one shared expert that every token uses.",
   "dur": 4.436,
   "voiced": 261,
   "sim": 0.865,
   "f0": 128.048,
   "st": 0.007,
   "range_st": 7.577,
   "asr": 1.0,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 11,
   "s": 70.585,
   "e": 76.234,
   "text": "This achieves extreme conditional specialization and sparse execution,",
   "dur": 5.649,
   "voiced": 269,
   "sim": 0.833,
   "f0": 121.034,
   "st": -0.969,
   "range_st": 5.661,
   "asr": 1.0,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 12,
   "s": 76.606,
   "e": 85.304,
   "text": "while keeping every expert a dense, hardware-friendly matrix, connected through collective all-to-all communication primitives.",
   "dur": 8.698,
   "voiced": 471,
   "sim": 0.851,
   "f0": 135.229,
   "st": 0.951,
   "range_st": 9.107,
   "asr": 1.0,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 13,
   "s": 86.279,
   "e": 90.98,
   "text": "Second, through Multi-head Latent Attention, or MLA.",
   "dur": 4.7,
