   "f0": 125.719,
   "st": -0.311,
   "range_st": 6.751,
   "asr": 1.0,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 15,
   "s": 97.313,
   "e": 106.145,
   "text": "MLA dynamically compresses keys and values into a compact low-dimensional latent vector,",
   "dur": 8.832,
   "voiced": 546,
   "sim": 0.866,
   "f0": 135.904,
   "st": 1.037,
   "range_st": 7.505,
   "asr": 1.0,
   "attempts": 1,
   "level": 0
  },
  {
   "i": 16,
   "s": 106.394,
