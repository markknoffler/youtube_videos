   "f0": 113.933,
   "st": -2.015,
   "range_st": 8.933,
   "asr": 1.0,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 17,
   "s": 111.402,
   "e": 114.76,
   "text": "Notice how this resolves the paradox:",
