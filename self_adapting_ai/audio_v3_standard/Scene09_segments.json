   "sim": 0.827,
   "f0": 137.409,
   "st": 1.228,
   "range_st": 7.428,
   "asr": 1.0,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 21,
   "s": 136.511,
   "e": 141.609,
   "text": "without paying the catastrophic cache penalty of irregular graph rewiring.",
   "dur": 5.097,
   "voiced": 333,
   "sim": 0.801,
   "f0": 121.715,
   "st": -0.872,
   "range_st": 6.071,
   "asr": 0.9,
   "attempts": 1,
   "level": 0
  },
  {
   "i": 22,
   "s": 142.664,
   "e": 147.962,
   "text": "By combining fine-grained mixture of experts with multi-head latent attention,",
   "dur": 5.298,
