  {
   "i": 4,
   "s": 17.884,
   "e": 19.14,
   "text": "The first idea:",
   "dur": 1.257,
   "voiced": 75,
   "sim": 0.505,
   "f0": 130.339,
   "st": 0.313,
   "range_st": 21.04,
   "asr": 1.0,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 5,
   "s": 19.728,
   "e": 23.462,
   "text": "rewire tiles, not synapses.",
