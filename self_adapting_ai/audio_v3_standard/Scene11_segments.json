   "f0": 119.088,
   "st": -1.249,
   "range_st": 4.61,
   "asr": 1.0,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 9,
   "s": 39.011,
   "e": 45.109,
   "text": "So what if structural plasticity worked at exactly that granularity,",
   "dur": 6.097,
