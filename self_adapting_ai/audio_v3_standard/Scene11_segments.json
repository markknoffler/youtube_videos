   "f0": 125.254,
   "st": -0.375,
   "range_st": 5.771,
   "asr": 1.0,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 6,
   "s": 24.045,
   "e": 29.677,
   "text": "Theorem three told us that random sparse graphs starve the GPU.",
   "dur": 5.632,
   "voiced": 314,
   "sim": 0.85,
   "f0": 125.171,
   "st": -0.387,
   "range_st": 8.767,
   "asr": 1.0,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 7,
   "s": 29.98,
   "e": 33.947,
   "text": "But a tensor core does not see synapses.",
   "dur": 3.967,
   "voiced": 184,
   "sim": 0.833,
   "f0": 121.772,
   "st": -0.864,
   "range_st": 9.058,
   "asr": 1.0,
   "attempts": 1,
   "level": 0
  },
  {
   "i": 8,
   "s": 34.567,
   "e": 37.761,
   "text": "It sees small dense tiles.",
