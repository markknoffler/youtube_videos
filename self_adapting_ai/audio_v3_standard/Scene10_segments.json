   "sim": 0.889,
   "f0": 127.708,
   "st": -0.039,
   "range_st": 6.962,
   "asr": 0.875,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 20,
   "s": 99.823,
   "e": 104.056,
