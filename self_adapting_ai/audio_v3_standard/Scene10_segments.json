 "segments": [
  {
   "i": 0,
   "s": 0.35,
   "e": 4.552,
   "text": "So far, this has been a story of failure.",
   "sim": 0.0,
   "dur": 4.202,
   "asr": 0.0,
   "trusted": true,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 1,
   "s": 4.772,
   "e": 6.067,
   "text": "But there is a twist.",
