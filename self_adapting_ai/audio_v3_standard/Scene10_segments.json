   "attempts": 1,
   "level": 0
  },
  {
   "i": 24,
   "s": 112.877,
   "e": 119.1,
   "text": "Schlag's team showed that pure outer-product writing hits a hard capacity wall.",
   "sim": 0.0,
   "dur": 6.222,
   "asr": 0.0,
   "trusted": true,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 25,
   "s": 119.32,
   "e": 122.199,
   "text": "Their fix was the delta rule:",
   "sim": 0.0,
   "dur": 2.88,
   "asr": 0.0,
   "trusted": true,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 26,
   "s": 122.392,
   "e": 126.462,
   "text": "before writing, read what the memory already predicts,",
   "sim": 0.0,
   "dur": 4.07,
   "asr": 0.0,
   "trusted": true,
   "attempts": 0,
   "reused": true
  },
  {
   "i": 27,
